# RUSH HOUR Hackathon Environment Configuration

# Neon PostgreSQL Connection String (include sslmode=require)
DATABASE_URL=postgres://user:password@host.neon.tech/neondb?sslmode=require

# Server Port
PORT=8000

# Resend Email API Key
RESEND_API_KEY=your_resend_api_key_here

# Admin Configuration
ADMIN_SECRET_PATH=/rh24-panel-x9q7m
ADMIN_PASSWORD=your_admin_password_here

# Super Admin Configuration
SUPERADMIN_SECRET_PATH=/rh24-super-panel-x9q7m
SUPERADMIN_PASSWORD=your_super_admin_password_here

# Hackathon Start Date (Format: YYYY-MM-DDTHH:MM:SS+05:30 for IST)
HACKATHON_START_DATE=2026-06-23T09:00:00+05:30
