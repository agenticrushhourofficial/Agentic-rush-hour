{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "**"
    },
    "server.js": {
      "includeFiles": "**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/rh24-panel-x9q7m",
      "destination": "/api/index.js"
    },
    {
      "source": "/rh24-super-panel-x9q7m",
      "destination": "/api/index.js"
    }
  ]
}
